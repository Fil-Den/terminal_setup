#!/usr/bin/env bash
# Attach to tmux session <name>, or create it from a template and attach.
# `tmux-session ls` lists running sessions and sessions with a template.
#
# Templates live in ${XDG_CONFIG_HOME:-~/.config}/tmux-session/:
#   <name>.conf     used for a session with that exact name
#   default.conf    used for every other session
# With no template, a plain session is created in the current directory.
set -euo pipefail

CONFIG_DIR="${TMUX_SESSION_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux-session}"

usage() { printf 'Usage: %s <session-name> | ls\n' "$(basename "$0")" >&2; exit 2; }
warn()  { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
trim()  { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

[[ $# -eq 1 && -n "$1" ]] || usage
command -v tmux >/dev/null 2>&1 || { warn "tmux not found"; exit 1; }

if [[ "$1" == "ls" ]]; then
  # Running sessions plus sessions that have their own template;
  # default.conf and example.conf are not session names
  running="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
  {
    [[ -n "$running" ]] && printf '%s\n' "$running"
    for f in "$CONFIG_DIR"/*.conf; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .conf)"
      [[ "$name" == default || "$name" == example ]] || printf '%s\n' "$name"
    done
  } | sort -u | while IFS= read -r name; do
    if grep -qxF -- "$name" <<<"$running"; then
      printf '%s (running)\n' "$name"
    else
      printf '%s\n' "$name"
    fi
  done
  exit
fi

# tmux does not allow '.' or ':' in session names
session="${1//[.:]/_}"

attach() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

if tmux has-session -t "=$session" 2>/dev/null; then
  attach
  exit
fi

# Expand ~ and $SESSION in a template field
expand() {
  local s="${1//\$SESSION/$session}"
  [[ "$s" == "~" || "$s" == "~/"* ]] && s="$HOME${s:1}"
  printf '%s' "$s"
}

template=""
for f in "$CONFIG_DIR/$session.conf" "$CONFIG_DIR/default.conf"; do
  [[ -f "$f" ]] && { template="$f"; break; }
done

if [[ -z "$template" ]]; then
  tmux new-session -d -s "$session" -c "$PWD"
  attach
  exit
fi

# Template format, one window per line:  name | directory | command
# directory defaults to the current directory, command is optional.
first_window=""
while IFS='|' read -r name dir cmd || [[ -n "$name" ]]; do
  name="$(trim "$name")"
  [[ -z "$name" || "$name" == \#* ]] && continue
  dir="$(expand "$(trim "${dir:-}")")"
  cmd="$(expand "$(trim "${cmd:-}")")"

  if [[ -z "$dir" ]]; then
    dir="$PWD"
  elif [[ ! -d "$dir" ]]; then
    warn "$template: directory '$dir' for window '$name' not found, using $PWD"
    dir="$PWD"
  fi

  if [[ -z "$first_window" ]]; then
    window="$(tmux new-session -d -P -F '#{window_id}' -s "$session" -n "$name" -c "$dir")"
    first_window="$window"
  else
    window="$(tmux new-window -d -P -F '#{window_id}' -t "=$session:" -n "$name" -c "$dir")"
  fi

  [[ -n "$cmd" ]] && tmux send-keys -t "$window" "$cmd" Enter
done < "$template"

if [[ -z "$first_window" ]]; then
  warn "$template defines no windows, creating a plain session"
  tmux new-session -d -s "$session" -c "$PWD"
else
  tmux select-window -t "$first_window"
fi

attach
